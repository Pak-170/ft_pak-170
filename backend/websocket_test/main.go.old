//package main

import (
	"log"
	"fmt"

	//	"net/http"

	"github.com/gin-gonic/gin"

)

// var upgrader = websocket.Upgrader {}

const (
	join = 0
	leave = 1
	chatMsg = 2
)

type	Chat struct {
	users		[]*User
	userCount	int
}

type	User struct  {
	id			uint
	username	string
	wsUser		*websocket.Conn
}

func (chat *Chat)reader(user *User) {
	ws := user.wsUser
	for {
		messageType, msg, err := ws.ReadMessage()
		fmt.Println(messageType)
		if err != nil {
			log.Println(err);
			ws.Close()
			break
		}
		chat.broadcast(string(msg), user, chatMsg)
	}
}




func (chat *Chat)broadcast(msg string, sender *User, msgType int) {

	if msg == "quit" {
		chat.removeUser(sender)
		sender.wsUser.Close()
	}

	var finalMsg []byte

	if msgType == join {
		finalMsg = []byte("user " + sender.username + " joined the chat")
	} else if msgType == leave {
		finalMsg = []byte("user " + sender.username + " left the chat")
	} else {
		finalMsg = []byte(sender.username + ": " + msg)
	}

	for _,user := range chat.users {
		if user == sender {
			continue
		}
		err := user.wsUser.WriteMessage(1, finalMsg)
		if err != nil {
			log.Println(err)
		}
	}
}

func (chat *Chat)removeUser(user *User) {
	user.wsUser.WriteMessage(2, []byte("Bye " + user.username + "."))
}

func (chat *Chat)addUser(user *User) {
	chat.users = append(chat.users, user)
	chat.userCount += 1
	err := user.wsUser.WriteMessage(1, []byte("Welcome " + user.username + "!"))
	if err != nil {
		log.Println(err)
		return
	}
	chat.broadcast("", user, join)
}

func (chat *Chat)handleWS(c *gin.Context) {
	ws, err := upgrader.Upgrade(c.Writer, c.Request, nil)
	if err != nil {
		log.Printf("UPGRADING HTTP CONNECTION TO WS FAILED: %v\n", err);
	}
	defer ws.Close()

	paramUsername := c.Param("username")
	if paramUsername == "" {
		ws.WriteMessage(1, []byte("ERROR: INVALID USERNAME\n"))
	} else {
		var user User = User{
			id: uint(chat.userCount),
			username: paramUsername,
			wsUser: ws}
		chat.addUser(&user)
		chat.reader(&user)
	}

}

func main() {

	r := gin.Default()
	var chat	Chat
	r.GET("/ws/:username", chat.handleWS)
	r.Run(":8080")
}